<Window x:Class="LAbeille_B3Q1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hub d'Applications C#" Height="450" Width="700"
        WindowStartupLocation="CenterScreen" Background="#F4F5F7">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Hub de Projets" FontSize="26" FontWeight="Bold" Foreground="#2C3E50"/>
            <TextBlock Text="Sélectionnez un outil ci-dessous pour démarrer" FontSize="14" Foreground="#7F8C8D"/>
        </StackPanel>

        <UniformGrid Grid.Row="1" Columns="2" Rows="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <Border Margin="10" Background="White" CornerRadius="8" Padding="15">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#CCCCCC" Direction="315" ShadowDepth="3" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📧 Envoi d'Emails" FontSize="18" FontWeight="SemiBold" Foreground="#2980B9" HorizontalAlignment="Center"/>
                    <TextBlock Text="System.Net.Mail &amp; Gmail SMTP" FontSize="11" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                    <Button Content="Ouvrir le module" Width="140" Height="35" Background="#3498DB" Foreground="White" 
                            FontWeight="Bold" BorderThickness="0" Click="OpenEmailApp_Click"/>
                </StackPanel>
            </Border>

            <Border Margin="10" Background="#FAFAFA" CornerRadius="8" Padding="15" BorderBrush="#E0E0E0" BorderThickness="2">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="➕ Nouveau Projet" FontSize="18" FontWeight="SemiBold" Foreground="#BDC3C7" HorizontalAlignment="Center"/>
                    <TextBlock Text="Emplacement disponible" FontSize="11" Foreground="#BDC3C7" HorizontalAlignment="Center" Margin="0,5,0,15"/>
                    <Button Content="À venir" Width="140" Height="35" IsEnabled="False" Background="#E0E0E0" Foreground="#A0A0A0" BorderThickness="0"/>
                </StackPanel>
            </Border>

        </UniformGrid>
    </Grid>
</Window>
