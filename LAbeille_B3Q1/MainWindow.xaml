<Window x:Class="LAbeille_B3Q1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LAbeille_B3Q1"
        Title="Mon Hub d'Applications WPF" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <!-- Déclaration des convertisseurs dans les ressources -->
    <Window.Resources>
        <local:TaskColorConverter x:Key="ColorConverter"/>
        <local:TaskDecorationConverter x:Key="DecorationConverter"/>
    </Window.Resources>

    <Grid>
        <TabControl TabStripPlacement="Left" Margin="5">

            <!-- MODULE 1 : Envoi de Mail -->
            <TabItem Header="📧 Envoi de Mail" FontSize="14" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Module d'envoi d'e-mail (SMTP)" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                        <GroupBox Header="Configuration Expéditeur &amp; Auth Google" Margin="0,0,0,10" Padding="10">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Content="Votre Email Gmail:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtExpediteur" Grid.Row="0" Grid.Column="1" Margin="5" Height="25"/>

                                <Label Content="Clé d'application 2FA:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                                <PasswordBox x:Name="txtMotDePasse" Grid.Row="1" Grid.Column="1" Margin="5" Height="25"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Message &amp; Destinataire" Margin="0,0,0,10" Padding="10">
                            <StackPanel>
                                <Label Content="Email du Destinataire:"/>
                                <TextBox x:Name="txtDestinataire" Margin="0,0,0,5" Height="25"/>

                                <Label Content="Objet du message:"/>
                                <TextBox x:Name="txtObjet" Margin="0,0,0,5" Height="25"/>

                                <Label Content="Corps du message:"/>
                                <TextBox x:Name="txtCorps" TextWrapping="Wrap" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </GroupBox>

                        <Button x:Name="btnEnvoyer" Content="Envoyer l'E-mail" Height="35" Width="150" HorizontalAlignment="Right" Click="BtnEnvoyer_Click" Margin="0,5,0,10"/>
                        <TextBlock x:Name="txtStatut" Text="" Foreground="Blue" TextWrapping="Wrap" FontWeight="SemiBold"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- MODULE 2 : To-Do List -->
            <TabItem Header="📝 To-Do List" FontSize="14" Padding="10">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Gestionnaire de Tâches (To-Do List)" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,15"/>

                    <!-- Zone de saisie pour nouvelle tâche -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtNouvelleTache" Grid.Column="0" Height="30" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                        <Button x:Name="btnAjouter" Content="Ajouter" Grid.Column="1" Width="100" Height="30" Click="BtnAjouter_Click"/>
                    </Grid>

                    <!-- Liste des tâches -->
                    <ListBox x:Name="lstTaches" Grid.Row="2" Margin="0,0,0,10" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Case à cocher IsDone -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Titre avec convertisseurs pour style barré/couleur -->
                                    <TextBox Grid.Column="1" Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                             Foreground="{Binding IsDone, Converter={StaticResource ColorConverter}}"
                                             TextDecorations="{Binding IsDone, Converter={StaticResource DecorationConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Boutons d'actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                        <Button x:Name="btnSupprimer" Content="Supprimer la sélection" Width="160" Height="30" Margin="0,0,10,0" Click="BtnSupprimer_Click"/>
                        <Button x:Name="btnEnregistrer" Content="Enregistrer" Width="120" Height="30" Click="BtnEnregistrer_Click"/>
                    </StackPanel>

                    <!-- Notification statut -->
                    <TextBlock x:Name="txtStatutTodo" Grid.Row="4" Text="" Foreground="Green" FontWeight="SemiBold"/>
                </Grid>
            </TabItem>

            <!-- MODULE 3 : Emplacement futur -->
            <TabItem Header="⚙️ Autre Projet" FontSize="14" Padding="10">
                <Grid Margin="20">
                    <TextBlock Text="Prochain module à venir." VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="Gray" FontSize="16"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>