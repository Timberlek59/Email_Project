<Window x:Class="LAbeille_B3Q1.EmailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestionnaire d'Envoi d'Email" Height="550" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FFFFFF">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Envoyer un e-mail" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <TextBlock Text="Votre adresse Gmail :" FontWeight="SemiBold" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtExpediteur" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                <TextBlock Text="Clé d'application Gmail (2FA) :" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <PasswordBox x:Name="TxtPassword" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                <TextBlock Text="Adresse du destinataire :" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtDestinataire" Height="30" VerticalContentAlignment="Center" Padding="5"/>

                <TextBlock Text="Objet du message :" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtObjet" Height="30" VerticalContentAlignment="Center" Padding="5"/>


                <TextBlock Text="Message :" FontWeight="SemiBold" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtMessage" Height="120" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="5"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="TxtStatus" Grid.Row="2" Text="" Margin="0,10,0,10" FontWeight="Bold" HorizontalAlignment="Center"/>

        <Button x:Name="BtnEnvoyer" Grid.Row="3" Content="Envoyer le Mail" Height="40" 
                Background="#27AE60" Foreground="White" FontWeight="Bold" FontSize="14" 
                BorderThickness="0" Click="BtnEnvoyer_Click"/>
    </Grid>
</Window>
